# URL y clave publicable: Settings / API Keys en Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sólo servidor. Nunca usar prefijo NEXT_PUBLIC ni subir esta clave a Git.
# Se utiliza únicamente para crear cuentas desde la pantalla de administrador.
SUPABASE_SECRET_KEY=

# Sólo para nuestro entorno de demostración. Entrega al cliente: false.
PELUCARS_DEMO_TOOLS=false
# Referencia informativa, provisional hasta acordar con el cliente.
DOLAR_API_CASA=oficial
