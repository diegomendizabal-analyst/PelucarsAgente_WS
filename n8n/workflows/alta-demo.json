        "jsCode": "for(const name of [\"Clientes y oportunidades\",\"Oportunidad propuesta\",\"Conversación propuesta\"]) { const r=$(name).first().json;if(r.statusCode!==200 || !Array.isArray(r.body) || r.body.length!==0) throw new Error('Cambió la situación antes del alta: '+name); } return {json:{ok:true}};"
