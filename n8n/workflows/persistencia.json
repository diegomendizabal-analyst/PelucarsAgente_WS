    {
      "id": "3488829b-523b-4e00-9874-dead1015d299",
      "name": "Comprobar idempotencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const first = $('Registrar entrante demo').first().json.body?.[0];\nconst second = $json.body?.[0];\nconst plan = $('Vista previa').first().json;\nif (!first?.message_id || first.conversation_id !== plan.conversation_id ||\n  first.created !== (plan.clave_previa.length === 0) ||\n  second?.message_id !== first.message_id || second.conversation_id !== first.conversation_id ||\n  second.history_position !== first.history_position || second.created !== false)\n  throw new Error('Las respuestas de ingreso no verifican idempotencia');\nreturn {json:{message_id:first.message_id,history_position:first.history_position,primero_creado:first.created,segundo_creado:second.created}};"
      }
    },
