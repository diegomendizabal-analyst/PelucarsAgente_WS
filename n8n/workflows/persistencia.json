    {
      "id": "ca7c6c04-3919-45b2-ba8d-ea11a4da75ea",
      "name": "Vista previa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const plan = $('Datos de prueba').first().json;\nconst candidates = $('Seleccionar oportunidad demo').first().json.body;\nconst lead = candidates?.[0];\nif (candidates.length !== 1 || lead.source !== 'demo' || !lead.customers?.phone_e164) throw new Error('Oportunidad demo no disponible');\nconst state = $('Leer estado previo').first().json.body;\nconst history = $('Leer historial previo').first().json.body;\nconst key = $json.body;\nif(![state,history,key].every(Array.isArray)) throw new Error('Lectura inválida');\nif (lead.id !== 'DEMO_OPORTUNIDAD_UUID' || lead.customers.id !== 'DEMO_CLIENTE_UUID' || lead.customers.phone_e164 !== '+DEMO_REMITENTE_META') throw new Error('La oportunidad demo cambió');\nif (state.length > 1 || key.length > 1) throw new Error('Resultado previo ambiguo');\nif (state.length || key.length || history.length) {\n  const own = state[0]?.lead_id === lead.id && state[0]?.bot_state === 'collecting' && state[0]?.reserved_slots === 0 && state[0]?.sent_count === 0 &&\n    key[0]?.conversation_id === plan.conversation_id && history.length === 1 &&\n    history[0].message_id === key[0].id && history[0].sender_kind === 'customer' && history[0].body === plan.body;\n  if (!own) throw new Error('Colisión con datos previos. Se detuvo antes de escribir.');\n}\nreturn {json:{...plan,lead_id:lead.id,referencia:lead.reference_number,estado_comercial:lead.commercial_status,source:lead.source,customer_id:lead.customers.id,phone_e164:lead.customers.phone_e164,rpc:$('Verificar contrato publicado').first().json.rpc,estado_previo:state,historial_previo:history.length,clave_previa:key}};"
      }
    },
