    {
      "id": "995952c8-3a22-4ed7-80f8-2db628e30c08",
      "name": "Verificar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $('Comprobar idempotencia').first().json;\nconst history = $('Recuperar historial').first().json.body;\nconst plan = $('Vista previa').first().json;\nconst s = $json.body?.[0];\nif (history?.length !== 1 || history[0]?.message_id !== r.message_id ||\n    history[0]?.history_position !== r.history_position || history[0]?.sender_kind !== 'customer' ||\n    history[0]?.body !== plan.body || s?.conversation_id !== plan.conversation_id || s?.lead_id !== plan.lead_id ||\n    s?.bot_state !== 'collecting' || s?.reserved_slots !== 0 || s?.sent_count !== 0)\n  throw new Error('El historial o el estado no coinciden con la prueba');\nreturn {json:{...r,estado:s,historial:history}};"
      }
    }
