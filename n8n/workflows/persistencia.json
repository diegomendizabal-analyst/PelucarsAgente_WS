      "name": "Verificar contrato publicado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const paths = $json.body?.paths;\nconst expected = {receive_bot_message:['p_conversation_id','p_lead_id','p_source','p_phone_e164','p_provider','p_business_phone_id','p_provider_message_id','p_body'],get_bot_conversation:['p_conversation_id'],bot_message_history:['p_conversation_id','p_before','p_after','p_limit']};\nfor (const [name,keys] of Object.entries(expected)) {\n const post = paths?.['/rpc/'+name]?.post;\n const p = post?.parameters?.find(x => x.in === 'body')?.schema?.properties;\n if(!p || !keys.every(k => Object.hasOwn(p,k))) throw new Error('Firma no disponible: '+name);\n}\nreturn {json:{rpc:Object.keys(expected)}};"
      }
    },
