      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('Parámetros acordados').first().json;\nfunction historyOK(rows) {\n  return Array.isArray(rows) && rows.length === 2 && rows.every((r,i) =>\n    r.message_id === p.historial[i].message_id && r.history_position === p.historial[i].history_position &&\n    r.sender_kind === 'customer' && r.body === p.historial[i].body);\n}\nfunction stateOK(rows, state, slots) {\n  return Array.isArray(rows) && rows.length === 1 && rows[0].conversation_id === p.args.p_conversation_id &&\n    rows[0].lead_id === p.lead_id && rows[0].bot_state === state && rows[0].reserved_slots === slots && rows[0].sent_count === 0;\n}\nif (!stateOK($('Estado previo').first().json.body, 'collecting', 0) ||\n    !historyOK($('Historial previo').first().json.body) || !Array.isArray($json.body) || $json.body.length !== 0)\n  throw new Error('Precondiciones incumplidas. Revisar estado, historial y respuesta asociada.');\nreturn {json:{modo:p.modo,precondiciones:true,args:p.args}};"
      }
    },
