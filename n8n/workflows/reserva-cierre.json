        "jsCode": "const p = $('Parámetros acordados').first().json;\nfunction historyOK(rows) {\n  return Array.isArray(rows) && rows.length === 2 && rows.every((r,i) =>\n    r.message_id === p.historial[i].message_id && r.history_position === p.historial[i].history_position &&\n    r.sender_kind === 'customer' && r.body === p.historial[i].body);\n}\nfunction stateOK(rows, state, slots) {\n  return Array.isArray(rows) && rows.length === 1 && rows[0].conversation_id === p.args.p_conversation_id &&\n    rows[0].lead_id === p.lead_id && rows[0].bot_state === state && rows[0].reserved_slots === slots && rows[0].sent_count === 0;\n}\nconst rows = $json.body, r = $('Comparar registros').first().json;\nconst s = $('Estado final').first().json.body, h = $('Historial final').first().json.body;\nif (!stateOK(s,'waiting_assignment',1) || !historyOK(h) || !Array.isArray(rows) || rows.length !== 1 ||\n    !['id','conversation_id','reply_to','body','reply_kind','bot_slot','send_state','sender_kind'].every(k => rows[0][k] === r[k]))\n  throw new Error('Estado, respuesta persistida o historial final inesperado');\nreturn {json:{id_primera_reserva:$('Comprobar primera reserva').first().json.id,id_segunda_reserva:r.id,respuesta:rows[0],estado:s[0],historial:h}};"
